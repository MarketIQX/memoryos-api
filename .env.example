# MemoryOS API — Environment Variables
# Copy this to .env for local development
# Never commit .env to GitHub

# Supabase — memoryos-prod project (Singapore)
# Get from: supabase.com → Project Settings → API
MEMORYOS_SUPABASE_URL=https://your-project.supabase.co
MEMORYOS_SUPABASE_KEY=your-service-role-key-here

# Voyage AI — voyage-3-lite embeddings
# Get from: voyageai.com → API Keys
VOYAGE_API_KEY=pa-your-key-here

# Upstash Redis — memoryos-redis (Singapore)
# Get from: upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Anthropic — Claude synthesis for /memory/context
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# App Security
# Generate: 32 random alphanumeric characters
# Used to sign internal API calls during development
MEMORYOS_SECRET=your-32-char-random-secret-here

# App Config
PORT=8000
ENVIRONMENT=production
